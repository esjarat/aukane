[sub_resource type="Resource" id="Resource_anikr"]
script = ExtResource("1_7ok28")
texto = "Pues mira… yo llevo aquí en el mercado de Aukane…\\nbastantes años ya, joven."
metadata/_custom_type_script = "uid://lxtyea467oc"

[sub_resource type="Resource" id="Resource_rgq1r"]
script = ExtResource("1_7ok28")
texto = "Antes esta aldea no era más que 5 chozas y un pozo.\\nAhora mira: granjas, huertos y…"
metadata/_custom_type_script = "uid://lxtyea467oc"

[sub_resource type="Resource" id="Resource_7ok28"]
script = ExtResource("1_7ok28")
texto = "Bueno, ya me pongo viejo y charlatán 😅.\\n¿Volvemos a lo importante?"
metadata/_custom_type_script = "uid://lxtyea467oc"

[sub_resource type="Resource" id="Resource_pb4n3"]
script = ExtResource("2_rgq1r")
texto_opcion = "🛒 Quiero COMPRAR"
id_siguiente_dialogo = &"mercader_menu_comprar"
metadata/_custom_type_script = "uid://7bpii770t7mv"

[sub_resource type="Resource" id="Resource_ecgkd"]
script = ExtResource("2_rgq1r")
texto_opcion = "👋 Volver más tarde"
metadata/_custom_type_script = "uid://7bpii770t7mv"

